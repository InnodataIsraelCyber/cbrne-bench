FROM python:3.11-slim

WORKDIR /workspace

# Install system dependencies
RUN apt-get update && apt-get install -y \
    git \
    wget \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies for RFdiffusion-like functionality
RUN pip install --no-cache-dir \
    biopython \
    numpy \
    scipy \
    pandas
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu

# RFdiffusion installation (if model weights available)
# Model weights should be mounted at /workspace/models/
RUN mkdir -p /workspace/models

# Copy configuration and scripts
COPY scripts/stage2_entrypoint.sh /workspace/
COPY scripts/stage2_scaffolding.py /workspace/

RUN chmod +x /workspace/stage2_entrypoint.sh

# Set environment
ENV DATA_INPUT=/data/structures
ENV DATA_OUTPUT=/data/scaffolds
ENV FIXED_POSITIONS="80 123 177 180 209"
ENV NUM_DESIGNS=10
ENV CUDA_VISIBLE_DEVICES=0

ENTRYPOINT ["/workspace/stage2_entrypoint.sh"]

