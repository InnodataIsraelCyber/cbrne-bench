FROM nvidia/cuda:12.2.2-devel-ubuntu22.04

WORKDIR /app

RUN apt-get update && apt-get install -y \
    wget curl git python3.10 python3-pip \
    build-essential openmpi-bin libopenmpi-dev \
    && rm -rf /var/lib/apt/lists/*

# Install validation and scoring dependencies
RUN pip install --no-cache-dir \
    biopython==1.83 \
    pyyaml==6.0 \
    numpy==1.25.2 \
    pandas==2.0.0 \
    scikit-learn==1.3.0 \
    torch==2.1.0 \
    scipy==1.11.0 \
    matplotlib==3.7.0

# Copy ESMFold
RUN mkdir -p /app/esmfold
COPY esmfold/ /app/esmfold/
RUN pip install -e /app/esmfold/ 2>/dev/null || echo "ESMFold not found"

# Copy AlphaFold3 (for Phase 3b complex prediction)
RUN mkdir -p /app/alphafold3
COPY alphafold3/ /app/alphafold3/
RUN pip install -e /app/alphafold3/ 2>/dev/null || echo "AlphaFold3 not found"

# Download/Install Rosetta (if license available)
RUN mkdir -p /app/rosetta && \
    echo "Note: Rosetta requires separate installation with license" && \
    echo "See: https://www.rosettacommons.org/"

# Install FoldX (standalone)
RUN mkdir -p /app/foldx && \
    echo "Note: FoldX requires separate installation" && \
    echo "See: http://foldx.crg.es/"

# Copy entrypoint scripts for all Phase 3 substeps
COPY scripts/run_phase3a.py /app/run_phase3a.py
COPY scripts/run_phase3b.py /app/run_phase3b.py
COPY scripts/run_phase3c.py /app/run_phase3c.py
COPY scripts/run_phase3d.py /app/run_phase3d.py

RUN chmod +x /app/run_phase3*.py

ENV CUDA_VISIBLE_DEVICES=0
ENV PYTHONUNBUFFERED=1
ENV NVIDIA_VISIBLE_DEVICES=all

# Default to 3a; can be overridden
ENTRYPOINT ["python3", "/app/run_phase3a.py"]
