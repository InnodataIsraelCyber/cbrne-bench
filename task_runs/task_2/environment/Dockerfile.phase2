FROM nvidia/cuda:12.2.2-devel-ubuntu22.04

WORKDIR /app

RUN apt-get update && apt-get install -y \
    wget curl git python3.10 python3-pip \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install ProteinMPNN dependencies
RUN pip install --no-cache-dir \
    biopython==1.83 \
    pyyaml==6.0 \
    numpy==1.25.2 \
    pandas==2.0.0 \
    torch==2.1.0 \
    scikit-learn==1.3.0

# Copy ProteinMPNN source
RUN mkdir -p /app/proteinmpnn
COPY proteinmpnn/ /app/proteinmpnn/

# Install ProteinMPNN
RUN pip install -e /app/proteinmpnn/ 2>/dev/null || echo "ProteinMPNN source not found"

# Copy entrypoint script
COPY scripts/run_phase2.py /app/run_phase2.py
RUN chmod +x /app/run_phase2.py

ENV CUDA_VISIBLE_DEVICES=0
ENV PYTHONUNBUFFERED=1
ENV NVIDIA_VISIBLE_DEVICES=all

ENTRYPOINT ["python3", "/app/run_phase2.py"]
